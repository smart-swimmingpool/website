# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.toml]
max_line_length = 100

[*.md]
# Continuation lines of ordered lists are indented by 3; markdownlint checks list indentation
indent_size = unset
trim_trailing_whitespace = false

[.gitmodules]
indent_style = tab

[layouts/shortcodes/*.html]
insert_final_newline = false
